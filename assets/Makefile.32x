# ==============================================================================
# Sega 32X Dual SH-2 Master/Slave IPC & Spinlock Demo Makefile
# Builds concrete dual-core synchronization, semaphore & FIFO test binary
#
# Copyright (c) 2026 Dan Leslie, Joseph Groff, Victor Luchits
# SPDX-License-Identifier: MIT
# ==============================================================================

PROJECT_ROOT ?= $(CURDIR)
OPT_DIR      ?= $(PROJECT_ROOT)/opt
GENDEV       ?= $(OPT_DIR)

TARGET       ?= test_32x
BUILD_DIR    := build_32x
OUT_DIR      := out_32x

# Cross Compilers
SHPREFIX     := $(OPT_DIR)/sh-elf/bin/sh-elf-
MDPREFIX     := $(OPT_DIR)/m68k-elf/bin/m68k-elf-

SHCC         := $(SHPREFIX)gcc
SHAS         := $(SHPREFIX)as
SHLD         := $(SHPREFIX)ld
SHOBJC       := $(SHPREFIX)objcopy
SHSIZE       := $(SHPREFIX)size

MDCC         := $(MDPREFIX)gcc
MDOBJC       := $(MDPREFIX)objcopy

HOSTCC       ?= cc

# SH-2 Compiler Flags
SH_INCS      := -Iassets/32x/src/sh2
SH_FLAGS     := -m2 -mb -mtas -std=c11 -O2 -fomit-frame-pointer \
                -ffunction-sections -fdata-sections \
                -Wall -Wextra -Wno-unused-parameter \
                -D__32X__ -DMARS $(SH_INCS)
SH_LDFLAGS   := -T assets/32x/src/sh2/mars.ld -nostdlib -Wl,--gc-sections
SH_LIBGCC    := $(shell $(SHCC) -m2 -mb -print-libgcc-file-name 2>/dev/null || true)
SH_LIBS      := $(SH_LIBGCC)

.PHONY: all clean check check-tools

all: check-tools $(OUT_DIR)/$(TARGET).32x

check-tools:
	@if [ ! -f "$(SHCC)" ]; then \
		echo "!! sh-elf-gcc not found in $(OPT_DIR). Run: bash assets/setup.sh"; \
		exit 1; \
	fi

$(BUILD_DIR) $(OUT_DIR):
	mkdir -p $@

SH_OBJS := $(BUILD_DIR)/mars_header.o \
           $(BUILD_DIR)/mars_crt0.o \
           $(BUILD_DIR)/sh2_ipc.o \
           $(BUILD_DIR)/sh2_test.o \
           $(BUILD_DIR)/mars_master.o \
           $(BUILD_DIR)/mars_slave.o

$(BUILD_DIR)/md_start.o: assets/32x/src/md_start.s | $(BUILD_DIR)
	@echo ">> Assembling Genesis 68000 boot stub..."
	$(MDCC) -m68000 -x assembler-with-cpp -Wa,--register-prefix-optional -c $< -o $@

$(BUILD_DIR)/md_start.bin: $(BUILD_DIR)/md_start.o
	$(MDOBJC) -O binary -j .text $< $@

$(BUILD_DIR)/mars_header.o: assets/32x/src/sh2/mars_header.s $(BUILD_DIR)/md_start.bin | $(BUILD_DIR)
	@echo ">> Assembling 32X cartridge header..."
	$(SHAS) --big -I $(BUILD_DIR) $< -o $@

$(BUILD_DIR)/mars_crt0.o: assets/32x/src/sh2/mars_crt0.s | $(BUILD_DIR)
	@echo ">> Assembling 32X Dual SH-2 boot vector..."
	$(SHAS) --big $< -o $@

$(BUILD_DIR)/sh2_ipc.o: assets/32x/src/sh2/sh2_ipc.c assets/32x/src/sh2/sh2_ipc.h | $(BUILD_DIR)
	@echo ">> Compiling SH-2 IPC, spinlocks, & ring-buffer queues..."
	$(SHCC) $(SH_FLAGS) -c $< -o $@

$(BUILD_DIR)/sh2_test.o: assets/32x/src/sh2/sh2_test.c assets/32x/src/sh2/sh2_test.h assets/32x/src/sh2/sh2_ipc.h | $(BUILD_DIR)
	@echo ">> Compiling Dual SH-2 synchronization test suite..."
	$(SHCC) $(SH_FLAGS) -c $< -o $@

$(BUILD_DIR)/mars_master.o: assets/32x/src/sh2/mars_master.c assets/32x/src/sh2/sh2_ipc.h assets/32x/src/sh2/sh2_test.h | $(BUILD_DIR)
	@echo ">> Compiling Master SH-2 VDP renderer & orchestrator..."
	$(SHCC) $(SH_FLAGS) -c $< -o $@

$(BUILD_DIR)/mars_slave.o: assets/32x/src/sh2/mars_slave.c assets/32x/src/sh2/sh2_ipc.h assets/32x/src/sh2/sh2_test.h | $(BUILD_DIR)
	@echo ">> Compiling Slave SH-2 worker & audio processing loop..."
	$(SHCC) $(SH_FLAGS) -c $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(SH_OBJS) | $(BUILD_DIR)
	@echo ">> Linking 32X Dual SH-2 ELF..."
	$(SHCC) $(SH_LDFLAGS) $^ $(SH_LIBS) -o $@
	$(SHSIZE) $@

$(OUT_DIR)/$(TARGET).32x: $(BUILD_DIR)/$(TARGET).elf | $(OUT_DIR)
	@echo ">> Generating raw 32X cartridge image..."
	$(SHOBJC) -O binary $< $(BUILD_DIR)/$(TARGET).raw
	cp $(BUILD_DIR)/$(TARGET).raw $@
	python3 assets/romfix.py $@
	@echo ">> 32X ROM build complete: $@"

$(BUILD_DIR)/pico32x_comm_check: assets/tests/pico32x_comm_check.c | $(BUILD_DIR)
	@echo ">> Compiling PicoDrive 32X regression runner..."
	$(HOSTCC) -O2 -Wall $< -ldl -o $@

check: $(OUT_DIR)/$(TARGET).32x $(BUILD_DIR)/pico32x_comm_check
	@echo ">> Verifying 32X binary structure..."
	@ls -la $(OUT_DIR)/$(TARGET).32x
	@test -f $(BUILD_DIR)/$(TARGET).elf && echo "ELF image verified."
	@echo ">> Running automated PicoDrive headless regression check..."
	$(BUILD_DIR)/pico32x_comm_check $(OPT_DIR)/libretro/picodrive_libretro.so $(OUT_DIR)/$(TARGET).32x

clean:
	rm -rf $(BUILD_DIR) $(OUT_DIR)
