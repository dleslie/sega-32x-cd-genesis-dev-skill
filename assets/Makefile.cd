# ==============================================================================
# Sega CD Turnkey Master Makefile
# Compiles Genesis Main-68K, Sub-CPU 68K, and masters bootable ISO/CHD disc images
#
# Copyright (c) 2026 Dan Leslie
# SPDX-License-Identifier: MIT
# ==============================================================================

PROJECT_ROOT ?= $(CURDIR)
OPT_DIR      ?= $(PROJECT_ROOT)/opt
GDK          ?= $(OPT_DIR)/m68k-elf

TARGET       ?= game
BUILD_DIR    := build_cd
OUT_DIR      := out_cd
DISC_DIR     := $(BUILD_DIR)/disc_staging

# Cross Compilers (M68K-ELF GCC 14.2.0)
MDPREFIX     := $(OPT_DIR)/m68k-elf/bin/m68k-elf-
MDCC         := $(MDPREFIX)gcc
MDAS         := $(MDPREFIX)as
MDLD         := $(MDPREFIX)ld
MDOBJC       := $(MDPREFIX)objcopy
MDSIZE       := $(MDPREFIX)size

# 1. Genesis Main-CPU Compilation Flags (SGDK runtime)
MD_INCS      := -Iassets/cd/src/main_68k -I$(GDK)/inc -I$(GDK)/res -I$(BUILD_DIR)
MD_FLAGS     := -DSGDK_GCC -m68000 -std=c11 -O2 -fno-builtin -fomit-frame-pointer \
                -ffunction-sections -fdata-sections -Wall -Wextra \
                -Wno-unused-parameter -Wno-main $(MD_INCS)
MD_LIBGCC    := $(shell $(MDCC) -m68000 -print-libgcc-file-name 2>/dev/null || true)
MD_LIBS      := $(GDK)/lib/libmd.a $(MD_LIBGCC)

# 2. Sega CD Sub-CPU 68000 Compilation Flags
SUB_INCS     := -Iassets/cd/src/sub_68k
SUB_FLAGS    := -m68000 -std=c11 -O2 -fomit-frame-pointer -ffunction-sections -fdata-sections \
                -Wall -Wextra $(SUB_INCS)
SUB_LIBS     := $(MD_LIBGCC)
SUB_LDFLAGS  := -T assets/cd/src/sub_68k/sub_68k.ld -nostdlib -Wl,--gc-sections

.PHONY: all chd cue clean check check-tools

all: check-tools $(OUT_DIR)/$(TARGET).chd

check-tools:
	@if [ ! -f "$(MDCC)" ]; then \
		echo "!! m68k-elf-gcc not found in $(OPT_DIR). Run: bash assets/setup.sh"; \
		exit 1; \
	fi
	@if [ ! -f "assets/build_disc.sh" ]; then \
		echo "!! assets/build_disc.sh script missing."; \
		exit 1; \
	fi

$(BUILD_DIR) $(OUT_DIR) $(DISC_DIR):
	mkdir -p $@

# ------------------------------------------------------------------------------
# 1. Sega CD Sub-CPU 68000 Binary
# ------------------------------------------------------------------------------
SUB_OBJS := $(BUILD_DIR)/sub_crt0.o \
            $(BUILD_DIR)/sub_asic.o \
            $(BUILD_DIR)/sub_pcm.o \
            $(BUILD_DIR)/sub_bram.o \
            $(BUILD_DIR)/sub_iso9660.o \
            $(BUILD_DIR)/sub_cdda.o \
            $(BUILD_DIR)/sub_cdrom.o \
            $(BUILD_DIR)/sub_main.o

$(BUILD_DIR)/sub_crt0.o: assets/cd/src/sub_68k/sub_crt0.s | $(BUILD_DIR)
	@echo ">> Assembling Sega CD Sub-CPU crt0..."
	$(MDCC) -m68000 -x assembler-with-cpp -c $< -o $@

$(BUILD_DIR)/sub_asic.o: assets/cd/src/sub_68k/sub_asic.c assets/cd/src/sub_68k/sub_asic.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD Sub-CPU ASIC coprocessor..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_pcm.o: assets/cd/src/sub_68k/sub_pcm.c assets/cd/src/sub_68k/sub_pcm.h assets/cd/src/sub_68k/sub_asic.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD Ricoh RF5C164 PCM driver..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_bram.o: assets/cd/src/sub_68k/sub_bram.c assets/cd/src/sub_68k/sub_bram.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD Backup RAM (BRAM) driver..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_iso9660.o: assets/cd/src/sub_68k/sub_iso9660.c assets/cd/src/sub_68k/sub_iso9660.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD ISO-9660 filesystem parser..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_cdda.o: assets/cd/src/sub_68k/sub_cdda.c assets/cd/src/sub_68k/sub_cdda.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD CD-DA audio streaming driver..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_cdrom.o: assets/cd/src/sub_68k/sub_cdrom.c assets/cd/src/sub_68k/sub_cdrom.h assets/cd/src/sub_68k/sub_iso9660.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD CD-ROM Word RAM streaming pipeline..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_main.o: assets/cd/src/sub_68k/sub_main.c assets/cd/src/sub_68k/sub_asic.h assets/cd/src/sub_68k/sub_pcm.h assets/cd/src/sub_68k/sub_bram.h assets/cd/src/sub_68k/sub_iso9660.h assets/cd/src/sub_68k/sub_cdda.h assets/cd/src/sub_68k/sub_cdrom.h | $(BUILD_DIR)
	@echo ">> Compiling Sega CD Sub-CPU main loop..."
	$(MDCC) $(SUB_FLAGS) -c $< -o $@

$(OUT_DIR)/sub.bin: $(SUB_OBJS) | $(OUT_DIR)
	@echo ">> Linking Sega CD Sub-CPU firmware..."
	$(MDCC) $(SUB_LDFLAGS) $^ $(SUB_LIBS) -o $(BUILD_DIR)/sub.elf
	$(MDOBJC) -O binary $(BUILD_DIR)/sub.elf $@
	$(MDSIZE) $(BUILD_DIR)/sub.elf

# ------------------------------------------------------------------------------
# 2. Genesis Main-CPU Binary (SGDK)
# ------------------------------------------------------------------------------
$(BUILD_DIR)/rom_head.o: assets/rom_header.c | $(BUILD_DIR)
	$(MDCC) $(MD_FLAGS) -c $< -o $@

$(BUILD_DIR)/rom_head.bin: $(BUILD_DIR)/rom_head.o
	$(MDOBJC) -O binary $< $@

out/rom_head.bin: $(BUILD_DIR)/rom_head.bin
	@mkdir -p out
	cp -f $< $@

$(BUILD_DIR)/sega.o: $(GDK)/src/boot/sega.s out/rom_head.bin | $(BUILD_DIR)
	$(MDCC) -x assembler-with-cpp -Wa,--register-prefix-optional,--bitwise-or \
		-Ibuild_cd -Iout -I$(GDK)/inc -c $< -o $@

$(BUILD_DIR)/main_cd.o: assets/cd/src/main_68k/main_cd.c | $(BUILD_DIR)
	@echo ">> Compiling Genesis Main-CPU coordinator..."
	$(MDCC) $(MD_FLAGS) -c $< -o $@

$(BUILD_DIR)/sub_payload.o: assets/cd/src/main_68k/sub_payload.s $(OUT_DIR)/sub.bin | $(BUILD_DIR)
	@echo ">> Embedding Sega CD Sub-CPU payload into Main-CPU container..."
	$(MDCC) -m68000 -x assembler-with-cpp -c $< -o $@

$(OUT_DIR)/main.bin: $(BUILD_DIR)/sega.o $(BUILD_DIR)/sub_payload.o $(BUILD_DIR)/main_cd.o | $(OUT_DIR)
	@echo ">> Linking Genesis Main-CPU binary..."
	$(MDCC) -m68000 -n -T $(GDK)/md.ld -nostdlib -Wl,--build-id=none \
		$^ $(MD_LIBS) -o $(BUILD_DIR)/main.elf -Wl,--gc-sections
	$(MDOBJC) -O binary $(BUILD_DIR)/main.elf $@
	$(MDSIZE) $(BUILD_DIR)/main.elf

# ------------------------------------------------------------------------------
# 3. Disc Mastering Pipeline (ISO-9660, CUE, CHD)
# ------------------------------------------------------------------------------
$(OUT_DIR)/$(TARGET).chd: $(OUT_DIR)/main.bin $(OUT_DIR)/sub.bin | $(OUT_DIR) $(DISC_DIR)
	@echo ">> Staging filesystem data..."
	cp -f $(OUT_DIR)/main.bin $(DISC_DIR)/MAIN.BIN
	cp -f $(OUT_DIR)/sub.bin $(DISC_DIR)/SUB.BIN
	@echo ">> Launching Disc Mastering Pipeline..."
	bash assets/build_disc.sh \
		-o $@ \
		-d $(DISC_DIR) \
		-t "SEGA CD TURNKEY GAME" \
		-V "SEGA_CD_GAME"

cue: $(OUT_DIR)/main.bin $(OUT_DIR)/sub.bin | $(OUT_DIR) $(DISC_DIR)
	@echo ">> Staging filesystem data..."
	cp -f $(OUT_DIR)/main.bin $(DISC_DIR)/MAIN.BIN
	cp -f $(OUT_DIR)/sub.bin $(DISC_DIR)/SUB.BIN
	bash assets/build_disc.sh \
		-o $(OUT_DIR)/$(TARGET).cue \
		-d $(DISC_DIR) \
		-t "SEGA CD TURNKEY GAME" \
		-V "SEGA_CD_GAME" \
		--cue-only

check: $(OUT_DIR)/main.bin $(OUT_DIR)/sub.bin
	@echo ">> Running Sega CD Sub-CPU architecture and driver oracle..."
	gcc -O2 -Wall -Wextra -Werror assets/tests/test_segacd_sub.c -o $(BUILD_DIR)/test_segacd_sub
	$(BUILD_DIR)/test_segacd_sub
	@echo ">> Running headless emulator boot check..."
	ROM=$(OUT_DIR)/main.bin bash assets/tests/run_headless_emulator_test.sh

clean:
	rm -rf $(BUILD_DIR) $(OUT_DIR) out/rom_head.bin
