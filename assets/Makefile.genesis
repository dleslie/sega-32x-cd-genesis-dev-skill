# ==============================================================================
# Sega Genesis Sprite Engine Demo Makefile
# Compiles standalone Genesis / Mega Drive cartridge ROM using SGDK & GCC 14.2.0
#
# Copyright (c) 2026 Dan Leslie & Stéphane Dallongeville
# SPDX-License-Identifier: MIT
# ==============================================================================

PROJECT_ROOT ?= $(CURDIR)
OPT_DIR      ?= $(PROJECT_ROOT)/opt
GDK          ?= $(OPT_DIR)/m68k-elf

TARGET       ?= genesis_demo
BUILD_DIR    := build_genesis
OUT_DIR      := out

# Cross Compilers (M68K-ELF GCC 14.2.0)
MDPREFIX     := $(OPT_DIR)/m68k-elf/bin/m68k-elf-
MDCC         := $(MDPREFIX)gcc
MDAS         := $(MDPREFIX)as
MDLD         := $(MDPREFIX)ld
MDOBJC       := $(MDPREFIX)objcopy
MDSIZE       := $(MDPREFIX)size

# 68000 Compilation Flags (SGDK runtime)
MD_INCS      := -Iassets/genesis/src -I$(GDK)/inc -I$(GDK)/res -I$(BUILD_DIR)
MD_FLAGS     := -DSGDK_GCC -m68000 -std=c11 -O2 -fno-builtin -fomit-frame-pointer \
                -ffunction-sections -fdata-sections -Wall -Wextra \
                -Wno-unused-parameter -Wno-main $(MD_INCS)
MD_LIBGCC    := $(shell $(MDCC) -m68000 -print-libgcc-file-name 2>/dev/null || true)
MD_LIBS      := $(GDK)/lib/libmd.a $(MD_LIBGCC)

.PHONY: all clean check check-tools

all: check-tools $(OUT_DIR)/$(TARGET).bin

check-tools:
	@if [ ! -f "$(MDCC)" ]; then \
		echo "!! m68k-elf-gcc not found in $(OPT_DIR). Run: bash assets/setup.sh"; \
		exit 1; \
	fi

$(BUILD_DIR) $(OUT_DIR):
	mkdir -p $@

$(OUT_DIR)/rom_head.o: assets/rom_header.c | $(OUT_DIR)
	$(MDCC) $(MD_FLAGS) -c $< -o $@

$(OUT_DIR)/rom_head.bin: $(OUT_DIR)/rom_head.o
	$(MDOBJC) -O binary $< $@

$(BUILD_DIR)/sega.o: $(GDK)/src/boot/sega.s $(OUT_DIR)/rom_head.bin | $(BUILD_DIR)
	$(MDCC) -x assembler-with-cpp -Wa,--register-prefix-optional,--bitwise-or \
		-I$(OUT_DIR) -I$(BUILD_DIR) -I$(GDK)/inc -c $< -o $@

$(BUILD_DIR)/main.o: assets/genesis/src/main.c assets/genesis/src/genesis_tiles.h | $(BUILD_DIR)
	@echo ">> Compiling Genesis Sprite Engine Demo..."
	$(MDCC) $(MD_FLAGS) -c $< -o $@

$(OUT_DIR)/$(TARGET).bin: $(BUILD_DIR)/sega.o $(BUILD_DIR)/main.o | $(OUT_DIR)
	@echo ">> Linking Genesis Sprite Demo Cartridge ROM..."
	$(MDCC) -m68000 -n -T $(GDK)/md.ld -nostdlib -Wl,--build-id=none \
		$^ $(MD_LIBS) -o $(BUILD_DIR)/$(TARGET).elf -Wl,--gc-sections
	$(MDOBJC) -O binary $(BUILD_DIR)/$(TARGET).elf $@
	$(MDSIZE) $(BUILD_DIR)/$(TARGET).elf

clean:
	rm -rf $(BUILD_DIR) $(OUT_DIR)/$(TARGET).bin $(OUT_DIR)/$(TARGET).elf

check: all
	@echo ">> Running headless emulator check on Genesis Sprite Demo..."
	ROM=$(OUT_DIR)/$(TARGET).bin bash assets/tests/run_headless_emulator_test.sh
